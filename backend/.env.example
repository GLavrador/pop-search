SUPABASE_URL="sua_url_aqui"
SUPABASE_SERVICE_KEY="sua_chave_service_role_aqui"

# Segredo com que o Supabase assina os tokens de sessao. O backend valida a
# assinatura localmente com ele, sem chamar o Supabase a cada requisicao.
# Onde ver: Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET="seu_jwt_secret_aqui"

GEMINI_API_KEY="sua_api_key_do_gemini"
LOG_LEVEL=DEBUG
# Teto diario de analises do projeto inteiro, somando todos os usuarios.
# Calibre pelo limite real em Google Cloud Console -> Generative Language API
# -> Quotas, dividido pela media de tokens por analise que a aba de admin mostra.
DAILY_ANALYSIS_LIMIT=100
